# Copy to .env and adjust: cp .env.example .env
# .env is git-ignored; every deploy has its own values (12-factor, III. Config).

# --- PostgreSQL (used both by the postgres container and by the app) ---
POSTGRES_DB=scheduler_db
POSTGRES_USER=psg_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=scheduler-postgres
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_POOL_CONNS=10
POSTGRES_MIN_POOL_CONNS=2

# --- HTTP ---
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=30m
JWT_ISSUER=meeting-scheduler
BCRYPT_COST=10

# --- Slots generation ---
SLOT_HORIZON=336h
SLOT_HORIZON_REPAIR_TZ=Europe/Moscow
SLOT_HORIZON_REPAIR_TIME=03:00
SLOT_HORIZON_FILLTAIL_INTERVAL=1h

# --- Conference service (mock) ---
CONFERENCE_MOCK_FAILURE_RATE=0.05

# --- Process ---
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
